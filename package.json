{
  "name": "call-time",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web",
    "packages/infra"
  ],
  "scripts": {
    "build": "npm run build -w @call-time/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "synth": "npm run synth -w @call-time/infra --",
    "deploy": "npm run build && npm run deploy -w @call-time/infra --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
